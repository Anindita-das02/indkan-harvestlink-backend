# =====================================================
# INDKAN HarvestLink - Backend Environment Variables
# =====================================================
# Copy this file to .env in the same directory:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# DO NOT commit your active .env file to Git.

# Application Server Port (Default: 5001)
PORT=5001

# Flask Environment (development / production)
FLASK_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=indkan_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT / HMAC Security Secret Key (Used for Admin Token signing)
# Replace with a cryptographically secure random string in production
SECRET_KEY=replace_with_a_long_random_secret
